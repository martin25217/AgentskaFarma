actions = {
    0: "NOOP",
    1: "FIRE",
    2: "UP",
    3: "RIGHT",
    4: "LEFT",
    5: "DOWN",
    6: "UP_RIGHT",
    7: "UP_LEFT",
    8: "DOWN_RIGHT"
}


# -----------------------
# PRAZNA Q TABLICA
# -----------------------

Q = defaultdict(lambda: np.zeros(len(actions)))


# -----------------------
# PARAMETRI UCENJA
# -----------------------

learning_rate = 0.1       # koliko brzo uči
discount = 0.95           # važnost budućih nagrada
epsilon = 1.0             # početno istraživanje
epsilon_decay = 0.995
min_epsilon = 0.01



# -----------------------
# ODABIR AKCIJE
# -----------------------

def choose_action(state):

    # istraživanje - slučajni potez
    if random.random() < epsilon:
        return random.choice(list(actions.keys()))

    # najbolji potez iz Q tablice
    return np.argmax(Q[state])



# -----------------------
# AŽURIRANJE Q TABLICE
# -----------------------

def update_Q(state, action, reward, next_state):

    old_value = Q[state][action]

    best_future = np.max(Q[next_state])

    new_value = old_value + learning_rate * (
        reward + discount * best_future - old_value
    )

    Q[state][action] = new_value



